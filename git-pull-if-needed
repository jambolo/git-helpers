#!/usr/bin/env bash
# version: 1.1.0
#
# Fetches the upstream of the current branch, then fast-forwards the branch and updates submodules if the branch is
# behind and hasn't diverged

set -e  # Exit on error

usage() {
    echo "Usage: git-pull-if-needed"
    echo "Fetches the upstream of the current branch. If the branch is behind and hasn't diverged, fast-forwards it and"
    echo "updates the submodules."
}

case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ $# -ne 0 ]; then
    usage >&2
    exit 1
fi

branch=$(git branch --show-current)
if [ -z "$branch" ]; then
    echo "Error: HEAD is detached." >&2
    exit 2
fi

if ! upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2> /dev/null); then
    echo "Error: Branch '$branch' has no upstream." >&2
    exit 2
fi

if ! git fetch --quiet; then
    echo "Error: Fetch failed." >&2
    exit 1
fi

read -r behind ahead < <(git rev-list --left-right --count '@{u}...HEAD')

if [ "$behind" -eq 0 ] && [ "$ahead" -eq 0 ]; then
    echo "- $branch is up to date with $upstream."
elif [ "$ahead" -eq 0 ]; then
    echo "- $branch is $behind commit(s) behind $upstream. Fast-forwarding."
    git merge --ff-only '@{u}'
    git submodule update --init --recursive
elif [ "$behind" -eq 0 ]; then
    echo "- $branch is $ahead commit(s) ahead of $upstream. Need to push."
else
    echo "- $branch has diverged from $upstream: $ahead commit(s) ahead and $behind commit(s) behind."
fi
