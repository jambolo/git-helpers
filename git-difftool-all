#!/usr/bin/env bash
# version: 1.1.0
#
# Runs git difftool in directory diff mode on all files that differ between the working directory and HEAD.

set -e  # Exit on error

usage() {
    echo "Usage: git-difftool-all [<path>]"
    echo "Displays the differences for <path> between the working directory and HEAD using difftool."
    echo "<path> defaults to the current directory. Staged and unstaged changes are included."
}

case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ $# -gt 1 ]; then
    usage >&2
    exit 1
fi

path="${1:-.}"

# Ensure the path exists in the working tree, the index, or HEAD
if [ ! -e "$path" ] \
    && ! git ls-files --error-unmatch -- "$path" >/dev/null 2>&1 \
    && [ -z "$(git ls-tree -r --name-only HEAD -- "$path")" ]; then
    echo "Error: '$path' does not match any file." >&2
    exit 1
fi

if git diff --quiet HEAD -- "$path"; then
    echo "No differences found."
    exit 0
fi

git difftool --dir-diff HEAD -- "$path"
