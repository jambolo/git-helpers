#!/usr/bin/env bash
# version: 1.1.0
#
# Commits all uncommitted changes, including untracked files, to a new branch named wip/<user>/<timestamp>, pushes it
# to origin, and switches back to the original branch, leaving the working tree clean.

set -e  # Exit on error

usage() {
    echo "Usage: git-push-wip"
    echo "Commits all uncommitted changes, including untracked files, to a new branch named wip/<user>/<timestamp>,"
    echo "pushes it to origin, and switches back to the original branch, leaving the working tree clean."
}

case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ $# -ne 0 ]; then
    usage >&2
    exit 1
fi

if [ -z "$(git status --porcelain)" ]; then
    echo "- No changes to commit."
    exit 0
fi

# Original branch, or the commit if HEAD is detached
original=$(git symbolic-ref -q --short HEAD || git rev-parse HEAD)

# Branch name from user.name, with each run of characters other than letters, digits, and '_' replaced by '-'
user=$(git config user.name || echo "${USER:-$USERNAME}")
user=$(printf '%s' "$user" | tr -cs 'A-Za-z0-9_' '-')
wip="wip/${user:-unknown}/$(date +%Y%m%d-%H%M%S)"

echo "- Creating branch $wip"
git checkout -q -b "$wip"

echo "- Committing changes"
git add -A
git commit -q --no-verify -m "WIP"

echo "- Pushing $wip to origin"
if ! git push -q --set-upstream origin "$wip"; then
    echo "Error: Push failed. The changes are committed on '$wip', which is still checked out." >&2
    echo "Retry with: git push --set-upstream origin $wip" >&2
    exit 1
fi

git checkout -q "$original"

echo "- Done. Pushed $wip to origin."
