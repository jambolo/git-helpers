#!/usr/bin/env bash
# version: 1.1.0
#
# Compares the differences between two branches or commits using git difftool in directory diff mode.

set -e  # Exit on error

usage() {
    echo "Usage: git-diff-branches <commit1> [<commit2>]"
    echo "Displays the differences between two branches or commits using difftool."
    echo "<commit2> defaults to HEAD."
}

case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    usage >&2
    exit 1
fi

from="$1"
to="${2:-HEAD}"

# Ensure both commits exist
for c in "$from" "$to"; do
    if ! git rev-parse --verify --quiet "$c^{commit}" >/dev/null; then
        echo "Error: '$c' is not a branch or commit." >&2
        exit 1
    fi
done

git difftool --dir-diff "$from..$to"
