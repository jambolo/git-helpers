#!/usr/bin/env bash
# version: 1.1.0
#
# Rebases all branches whose name matches a given pattern onto a specified branch

set -e  # Exit on error

usage() {
    echo "Usage: git-rebase-all <base branch> <pattern>"
    echo "Rebases all branches matching <pattern> onto <base branch>. Branches already based on <base branch> are"
    echo "skipped, so after resolving a conflict the command can be rerun to finish the remaining branches."
}

case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ $# -ne 2 ]; then
    usage >&2
    exit 1
fi

base=$1
pattern=$2

if ! git diff-index --quiet HEAD --; then
    echo "Error: You have uncommitted changes." >&2
    exit 1
fi

if ! git show-ref --verify --quiet "refs/heads/$base"; then
    echo "Error: Branch '$base' does not exist." >&2
    exit 1
fi

mapfile -t branches < <(git for-each-ref --format='%(refname:short)' "refs/heads/$pattern")

if [ ${#branches[@]} -eq 0 ]; then
    echo "Error: No branches match pattern '$pattern'." >&2
    exit 1
fi

# Original branch, or the commit if HEAD is detached
original=$(git symbolic-ref -q --short HEAD || git rev-parse HEAD)

status=0

for b in "${branches[@]}"; do
    if [ "$b" = "$base" ]; then
        continue
    fi

    if git merge-base --is-ancestor "$base" "$b"; then
        echo "- $b is already based on $base."
        continue
    fi

    echo "- Rebasing $b onto $base"
    if ! git rebase -q "$base" "$b"; then
        if [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
            echo "Error: Rebase of $b stopped. Resolve it with 'git rebase --continue' or 'git rebase --abort'," >&2
            echo "then rerun git-rebase-all to rebase the remaining branches." >&2
            exit 1
        fi
        echo "Error: Rebase of $b failed." >&2
        status=1
    fi
done

git checkout -q "$original"

exit $status
