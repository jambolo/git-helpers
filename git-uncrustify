#!/usr/bin/env bash
# version: 2.0.0
#
# Runs uncrustify on all modified and added C/C++ source and header files in the working tree.

set -e  # Exit on error

usage() {
    echo "Usage: git-uncrustify"
    echo "Runs uncrustify on all modified, added, and untracked C/C++ source and header files in the working tree."
    echo
    echo "The executable is the first found of:"
    echo "  git config uncrustify.path, \$UNCRUSTIFY, uncrustify on PATH."
    echo "The config file is the first found of:"
    echo "  git config --local uncrustify.config, .uncrustify.cfg or uncrustify.cfg in the repo root,"
    echo "  git config --global or --system uncrustify.config, \$UNCRUSTIFY_CONFIG, ~/.uncrustify.cfg, ~/uncrustify.cfg."
}

case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ $# -ne 0 ]; then
    usage >&2
    exit 1
fi

# Run from the root of the git repository
cd "$(git rev-parse --show-toplevel)"

# Find the executable
exe=$(git config --type=path --get uncrustify.path || true)
exe=${exe:-$UNCRUSTIFY}
exe=${exe:-$(command -v uncrustify || true)}
if [ -z "$exe" ]; then
    echo "Error: uncrustify not found. Set git config uncrustify.path or \$UNCRUSTIFY, or put it on PATH." >&2
    exit 2
fi
if ! command -v "$exe" > /dev/null; then
    echo "Error: uncrustify executable '$exe' not found." >&2
    exit 2
fi

# Find the config file
config=$(git config --local --type=path --get uncrustify.config || true)
if [ -z "$config" ]; then
    for f in .uncrustify.cfg uncrustify.cfg; do
        if [ -f "$f" ]; then
            config=$f
            break
        fi
    done
fi
if [ -z "$config" ]; then
    config=$(git config --global --type=path --get uncrustify.config ||
             git config --system --type=path --get uncrustify.config || true)
fi
if [ -z "$config" ]; then
    for f in "$UNCRUSTIFY_CONFIG" "$HOME/.uncrustify.cfg" "$HOME/uncrustify.cfg"; do
        if [ -n "$f" ] && [ -f "$f" ]; then
            config=$f
            break
        fi
    done
fi
if [ -z "$config" ]; then
    echo "Error: No uncrustify config file found. Run 'git-uncrustify -h' for the locations searched." >&2
    exit 2
fi
if [ ! -f "$config" ]; then
    echo "Error: uncrustify config file '$config' not found." >&2
    exit 2
fi

# Changed files compared to HEAD (or the empty tree before the first commit), plus untracked files
base=$(git rev-parse -q --verify HEAD || git hash-object -t tree /dev/null)
mapfile -d '' -t files < <(
    { git diff -z --name-only --diff-filter=ACMR "$base"; git ls-files -z --others --exclude-standard; } |
        grep -ziE '\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$' || true
)

if [ ${#files[@]} -eq 0 ]; then
    echo "- No modified or added C/C++ files found."
    exit 0
fi

echo "- Formatting ${#files[@]} file(s) using $config"
if ! printf '%s\0' "${files[@]}" | xargs -0 "$exe" --no-backup -l CPP -c "$config"; then
    echo "Error: uncrustify failed." >&2
    exit 1
fi
